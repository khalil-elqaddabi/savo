# ============ Local environment — NEVER ship secrets into the image ==========
.env
.env.*
!.env.example
.auth*
auth.json
Homestead.json
Homestead.yaml

# ============ Dependencies (rebuilt inside the build stages) ============
node_modules
vendor

# ============ Frontend build output (produced by the node stage) ============
public/build
public/hot
public/storage
public/fonts-manifest.dev.json

# ============ Runtime caches / logs (recreated at boot) ============
storage/*.key
storage/pail
storage/app
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore
bootstrap/cache/*.php

# ============ Version control ============
.git
.gitignore

# ============ Tests & tooling (not shipped to production) ============
tests
phpunit.xml
.editorconfig
_ide_helper.php
.phpunit.cache
.phpunit.result.cache
.phpactor.json
.phpstorm.meta.php
.php-cs-fixer.cache

# ============ Separate mobile app (not part of this Laravel image) ============
savo-mobile

# ============ OS / editor cruft ============
.DS_Store
Thumbs.db
.idea
.vscode
.cursor
.codex
.nova
.zed
*.log
